# OVH API credentials — copy to .env and fill in. .env is gitignored.
#
# Create an application for your region:
#   Europe : https://eu.api.ovh.com/createApp/
#   Canada : https://ca.api.ovh.com/createApp/
#   US     : https://api.us.ovhcloud.com/createApp/

APP_KEY=
APP_SECRET=

# Generated by `node ovh.mjs auth` — validate the printed URL, then paste the key here.
OVH_CONSUMER_KEY=

# Optional. ovh-eu (default), ovh-ca or ovh-us.
#OVH_ENDPOINT=ovh-eu

# Optional. Where backups, reports and the inventory are written. Default: ./storage
#OVH_STORAGE_DIR=./storage
