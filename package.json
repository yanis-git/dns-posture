{
  "name": "ovh-domain-manager",
  "version": "0.2.0",
  "description": "Attack-surface reduction and default-deny DNS hardening for a portfolio of OVHcloud domains: inventory dormant domains, score them against a compliance baseline mapped to RFC/ISO 27001/NIS2/ANSSI references, and publish anti-spoofing records",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Yanis Ghidouche",
  "bin": {
    "ovh-domain-manager": "./ovh.mjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  },
  "keywords": [
    "ovh",
    "ovhcloud",
    "dns",
    "dns-security",
    "email-security",
    "spf",
    "dkim",
    "dmarc",
    "caa",
    "spoofing",
    "domain",
    "compliance",
    "attack-surface",
    "default-deny",
    "anssi",
    "nis2",
    "iso27001"
  ]
}
